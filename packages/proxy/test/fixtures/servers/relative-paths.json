{
  "args": [
    "./node_modules/some-server/index.js",
    "--stdio"
  ],
  "command": "./bin/server.js",
  "languages": { "typescript": [
      ".ts"
    ] },
  "settings": {
    "tsserver": {
      "globalPlugins": [
        {
          "location": "./node_modules/some-plugin",
          "name": "some-plugin"
        }
      ]
    },
    "validate": "on"
  },
  "transport": "stdio"
}
