{
  "name": "lsp-proxy-config-default",
  "version": "0.2.0",
  "description": "Default server configs (vue, vtsls, eslint, oxlint) for lsp-proxy",
  "type": "module",
  "files": [
    ".lsp-proxy.json",
    "README.md",
    "servers"
  ],
  "scripts": {
    "compile:ts": "cpy .lsp-proxy.json dist/source/ && cpy \"servers/**\" dist/source/servers/",
    "coverage:codecov:upload": "gtb task coverage:codecov:upload",
    "coverage:vitest:merge": "gtb task coverage:vitest:merge",
    "generate-plugin": "generate-claude-plugin",
    "lint:eslint": "gtb task lint:eslint",
    "pack:npm": "gtb task pack:npm",
    "test:vitest:e2e": "gtb task test:vitest:e2e",
    "test:vitest:fast": "gtb task test:vitest:fast",
    "test:vitest:slow": "gtb task test:vitest:slow",
    "typecheck:ts": "gtb task typecheck:ts"
  },
  "dependencies": {
    "@lsp-mux/vscode-eslint-lsp": "catalog:",
    "@vtsls/language-server": "catalog:",
    "@vue/language-server": "catalog:",
    "@vue/typescript-plugin": "catalog:",
    "lsp-proxy-claude-code": "workspace:*",
    "oxlint": "catalog:"
  },
  "devDependencies": {
    "@gtbuchanan/eslint-config": "catalog:",
    "@gtbuchanan/vitest-config": "catalog:",
    "@types/cross-spawn": "catalog:",
    "cross-spawn": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "lsp-proxy": "workspace:*",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "vscode-languageserver-protocol": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "directory": "dist/source",
    "linkDirectory": false,
    "scripts": {
      "postinstall": "generate-claude-plugin"
    }
  }
}
